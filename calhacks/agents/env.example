# Copy to .env (never commit it) and fill in.
# ASI:One API key, from https://asi1.ai/dashboard/api-keys
ASI1_API_KEY=
# Private seed phrases: they fix each agent's address. Any long random text, kept secret.
CHAT_AGENT_SEED=
STOCK_AGENT_SEED=
MONEY_AGENT_SEED=
# The Back of House website the agents use as their tools
BACKOFHOUSE_URL=https://resta-calhacks.vercel.app
